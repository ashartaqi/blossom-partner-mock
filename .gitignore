# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node
node_modules/
*.log

# The SPA build is committed on purpose: the free host has no build step, so the
# built bundle ships with the repo and collectstatic picks it up there.
!frontend/dist/

# Local configuration and data — never committed.
# Each has a committed .env.example alongside it.
.env
.env.*
!.env.example

# The SQLite database. Holds real member rows, password hashes and OAuth client
# secret hashes, so it stays local even though none of it is production data.
db.sqlite3

# The OIDC signing key. Private key material — regenerated on first run.
keys/

# Generated PDF guides. Rebuilt from source, and large.
docs/

# OS / editor
.DS_Store
.idea/
.vscode/

# Build output: regenerated by collectstatic on every deploy.
staticfiles/
