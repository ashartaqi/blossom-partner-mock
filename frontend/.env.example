# Copy to .env. Nothing here is secret — Vite inlines every VITE_* value into the
# bundle, so a real secret placed here would ship to the browser.

# Where this app's own API lives (the Blossom backend).
VITE_API_BASE_URL=http://localhost:9000

# Where "Investments" points. This is Surmount's URL, not Blossom's — the
# hand-off begins on their side, and that link is the whole integration on this
# side. A plain navigation, never a fetch.
VITE_INVESTMENTS_URL=http://localhost:8000/api/sso/blossom/start/
