DEBUG=True
SECRET_KEY=generate-with-secrets.token_urlsafe(50)
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Absolute base URL this platform is reachable at from a browser. Used to build
# the `picture` claim, and as the default OIDC issuer.
PUBLIC_BASE_URL=http://localhost:9000

ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# The web app's origin. It signs in with credentials:"include", so this list must
# be exact — a wildcard is not allowed alongside credentials, and rightly so.
CORS_ALLOWED_ORIGINS=http://localhost:5300,http://127.0.0.1:5300

# --- OpenID Connect provider -------------------------------------------------
# ISSUER must be the exact origin relying parties are configured with, and must be
# https in production. It is the `iss` claim in every ID token and is checked on
# the other side for an exact match.
OIDC_ISSUER=http://localhost:9000
# Authorization code lifetime. RFC 6749 caps this at ten minutes and recommends
# shorter; 60s covers two redirects and one back-channel call.
OIDC_CODE_TTL_SECONDS=60
OIDC_SPA_URL=http://localhost:5300
# Defaults to <BASE_DIR>/keys/oidc_signing_key.pem, generated on first run at 0600.
# In production this comes from a secrets manager, not a file.
# OIDC_SIGNING_KEY_PATH=/run/secrets/oidc_signing_key.pem

# Clients are database rows, not settings — onboarding a partner needs no deploy:
#   manage.py register_oidc_client \
#     --client-id surmount-blossom \
#     --name "Surmount Investing" \
#     --redirect-uri https://api.surmount.example/api/sso/blossom/callback/ \
#     --trusted
# The secret is printed once; only its SHA-256 digest is stored.

# --- Token-exchange fallback -------------------------------------------------
# For a partner platform with no OIDC provider that will not be standing one up.
# Weaker: the secret is symmetric, so both sides can mint what the other verifies.
# Prefer OIDC.
SSO_CLIENT_ID=surmount-blossom
SSO_CLIENT_SECRET=generate-with-secrets.token_urlsafe(32)
SSO_CODE_TTL_SECONDS=60
SSO_ALLOWED_REDIRECT_URIS=http://localhost:8000/api/sso/blossom/token-exchange/callback/
SSO_DEFAULT_REDIRECT_URI=http://localhost:8000/api/sso/blossom/token-exchange/callback/
